{
  "name": "kattio-panel",
  "version": "0.1.0",
  "private": true,
  "description": "The Kattio page in Home Assistant: built into custom_components/kattio/www/",
  "type": "module",
  "scripts": {
    "build": "esbuild src/kattio-panel.ts --bundle --format=esm --target=es2021 --minify --legal-comments=none --outfile=../custom_components/kattio/www/kattio-panel.js",
    "watch": "npm run build -- --watch",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3"
  }
}
